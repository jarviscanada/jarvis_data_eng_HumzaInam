pipeline {
    agent {
        kubernetes {
            label 'jenkins-agent'
        }
    }

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REPO = '872979777793.dkr.ecr.us-east-1.amazonaws.com/springboot-demo'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/jarviscanada/jarvis_springboot_demo_app.git'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t $ECR_REPO:$IMAGE_TAG .'
            }
        }

        stage('Push') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login --username AWS --password-stdin 872979777793.dkr.ecr.us-east-1.amazonaws.com

                docker push $ECR_REPO:$IMAGE_TAG
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                kubectl set image deployment/springboot-demo-app-dev \
                springboot-demo-app=$ECR_REPO:$IMAGE_TAG
                '''
            }
        }
    }
}
